# ============================================
# Firebase Configuration
# ============================================
# Obtén estas credenciales en: https://console.firebase.google.com/
# Proyecto > Configuración > Configuración del proyecto > Apps web

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# Firebase Admin SDK (Server-side)
# ============================================
# IMPORTANTE: Estas credenciales son DIFERENTES a las del cliente (NEXT_PUBLIC_*)
# Son necesarias para que el servidor pueda acceder a Firestore
#
# Para obtenerlas:
# 1. Ve a Firebase Console: https://console.firebase.google.com/
# 2. Selecciona tu proyecto
# 3. Click en ⚙️ (engranaje) > Configuración del proyecto
# 4. Tab "Cuentas de servicio"
# 5. Click en "Generar nueva clave privada"
# 6. Descarga el archivo JSON y copia los valores:

# project_id del JSON (puede ser igual a NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_ADMIN_PROJECT_ID=your_project_id

# client_email del JSON (ej: firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# private_key del JSON (incluye todo, desde -----BEGIN hasta -----END)
# IMPORTANTE: En Vercel, pegar el valor completo incluyendo los saltos de línea
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...\n-----END PRIVATE KEY-----\n"

# ============================================
# Google Drive API Configuration
# ============================================
# Para crear carpetas de documentos para cada usuario/empresa
# Necesitas crear un Service Account en Google Cloud Console:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto o selecciona uno existente
# 3. Habilita la API de Google Drive: APIs & Services > Enable APIs > Google Drive API
# 4. Crea un Service Account: IAM & Admin > Service Accounts > Create
# 5. Genera una clave JSON para el Service Account
# 6. Copia el client_email y private_key del archivo JSON

# Email del Service Account (ej: mi-servicio@mi-proyecto.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com

# Llave privada del Service Account (incluye los \n, copia tal cual del JSON)
# IMPORTANTE: Mantén las comillas y los \n como están en el JSON
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...\n-----END PRIVATE KEY-----\n"

# ID de la carpeta raíz en Google Drive donde se crearán las carpetas de empresas
# 1. Crea una carpeta en tu Google Drive personal
# 2. Compártela con el Service Account (usando el email de arriba) como "Editor"
# 3. Copia el ID de la carpeta de la URL: drive.google.com/drive/folders/[ESTE_ES_EL_ID]
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# ============================================
# Monday.com API Configuration
# Obtén tu API Token en: https://monday.com/developers/apps
MONDAY_API_KEY=your_monday_api_key_here
MONDAY_API_VERSION=2026-07

# Solicitud automática de factura por WhatsApp (Monday -> Vercel -> Meta)
MONDAY_FMG_BOARD_ID=8964055261
MONDAY_WHATSAPP_WEBHOOK_SECRET=generate_a_long_random_secret
# disabled (predeterminado), test (solo FMG_WHATSAPP_TEST_ITEM_ID) o live
FMG_WHATSAPP_SEND_MODE=disabled
FMG_WHATSAPP_TEST_ITEM_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=your_permanent_system_user_token
# Nombre alterno ya usado por el proyecto en Vercel:
WHATSAPP_SYSTEM_USER_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=1006728382529440
WHATSAPP_TEMPLATE_NAME=solicitud_factura_jorge_recibo
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_GRAPH_VERSION=v23.0

# Configuración del tablero de leads (ya configurado)
# Board ID: 18393740781
# Los column IDs están definidos en src/lib/monday.ts

# Board opcional para suscripciones (puede ser el mismo que leads)
MONDAY_SUBSCRIPTIONS_BOARD_ID=18393740781

# ============================================
# Internal Automation
# ============================================
# Secret compartido para endpoints internos llamados desde Zapier/n8n.
# Usar como header: Authorization: Bearer ${FMG_AUTOMATION_SECRET}
FMG_AUTOMATION_SECRET=your_internal_automation_secret_here

# Webhook n8n que procesa recibos al terminar la carga en Drive/Monday.
FMG_RECEIPT_OCR_WEBHOOK_URL=https://n8n.example.com/webhook/fmg-receipt-ocr

# ============================================
# FMG Contador IA
# ============================================
# API key autorizada para el endpoint de producto /api/ai-accountant/chat.
OPENAI_API_KEY=your_openai_api_key_here

# Modelo configurable para no amarrar el producto a un modelo fijo.
OPENAI_MODEL=gpt-4o-mini

# Notas fiscales curadas opcionales para futuras actualizaciones DOF/SAT.
FMG_FISCAL_CONTEXT_NOTES=

# ============================================
# First Data / Fiserv Payment Gateway
# ============================================
# Obtén tus credenciales en: https://developer.firstdata.com/
# Documentación: https://docs.fiserv.dev/public/docs/payments-api-quickstart

# API Key proporcionada por First Data
FIRSTDATA_API_KEY=your_api_key_here

# API Secret para generar firmas HMAC
FIRSTDATA_API_SECRET=your_api_secret_here

# ID del comerciante asignado por First Data
FIRSTDATA_MERCHANT_ID=your_merchant_id_here

# ID de la terminal de pago
FIRSTDATA_TERMINAL_ID=your_terminal_id_here

# Entorno: 'sandbox' para pruebas, 'production' para producción
# Endpoints:
#   - Sandbox: https://cert.api.firstdata.com/gateway/v2
#   - Production: https://prod.api.firstdata.com/gateway/v2
FIRSTDATA_ENVIRONMENT=sandbox

# Secret para verificar webhooks de First Data
FIRSTDATA_WEBHOOK_SECRET=your_webhook_secret_here
